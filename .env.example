# Local development uses Arc Testnet with deterministic payment verification.
ARC_NETWORK=testnet
ARC_PAYMENT_MODE=fixture

# The Arc wallet that receives the USDC payment.
ARC_RECIPIENT_ADDRESS=0x1111111111111111111111111111111111111111

# Optional server-side RPC override for a paid or private endpoint. The browser
# always receives the documented public Arc RPC endpoint.
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# ARC_EXPLORER_URL=https://explorer.arc.io

# Fixed service price for one quotation.
ARC_QUOTE_PRICE_USDC=0.10

# Optional public site URL used by sitemap and social metadata.
# NEXT_PUBLIC_SITE_URL=https://arcproof-production.up.railway.app

# Optional completed-order ID used by the reviewer links on the home page.
# NEXT_PUBLIC_REVIEW_PROOF_ID=AP-AC247758

# Optional. Without a key, the deterministic parser is used.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-terra

# Optional local database location.
# ARCPROOF_DATA_DIR=./data
# ARCPROOF_DATABASE_PATH=./data/arcproof.sqlite

# Optional token that enables POST /api/admin/backup for scheduled backups.
# The endpoint returns 503 while this is unset.
# BACKUP_TOKEN=

# Optional: drop the stored quotation payload of completed orders after N days.
# Unset or 0 keeps results forever. Exempt published receipts that must never
# expire (comma-separated public ids).
# ARCPROOF_RESULT_RETENTION_DAYS=
# ARCPROOF_RETENTION_EXEMPT_IDS=
